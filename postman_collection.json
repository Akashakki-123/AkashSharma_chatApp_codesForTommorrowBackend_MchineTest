      "item": [
        {
          "name": "Signup User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const token = res.items?.token || res.data?.token;",
                  "const userId = res.items?.user?.id || res.data?.user?.id;",
                  "if (token) {",
                  "  pm.environment.set(\"token\", token);",
                  "  pm.collectionVariables.set(\"token\", token);",
                  "}",
                  "if (userId) {",
                  "  pm.environment.set(\"userAId\", userId);",
                  "  pm.collectionVariables.set(\"userAId\", userId);",
                  "}"
                ]
              }
            }
