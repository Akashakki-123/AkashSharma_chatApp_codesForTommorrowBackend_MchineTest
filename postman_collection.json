    {
      "name": "Chat_Core",
      "item": [
        {
          "name": "1. Create or Get 1:1 Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const chatId = res.items?.chatId || res.data?.chatId;",
                  "if (chatId) {",
                  "  pm.environment.set(\"chatId\", chatId);",
                  "  pm.collectionVariables.set(\"chatId\", chatId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/create",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "create"]
            }
          },
          "response": []
        },
        {
          "name": "2. Send Message (User A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const messageId = res.items?.id || res.data?.id;",
                  "if (messageId) {",
                  "  pm.environment.set(\"messageId\", messageId);",
                  "  pm.collectionVariables.set(\"messageId\", messageId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hey Bob! Let's sync on the backend task.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "message", "send"]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Messages (Ordered)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{tokenB}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "messages"],
              "query": [
                { "key": "limit", "value": "50" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. Mark Message Read (User B)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{tokenB}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userBId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "message", "{{messageId}}", "read"]
            }
          },
          "response": []
        },
        {
          "name": "5. Update Last Seen Message (User B)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{tokenB}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{messageId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "{{chatId}}", "lastseen"]
            }
          },
          "response": []
        },
        {
          "name": "6. List User Chats",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
